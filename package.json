{
  "name": "watched-blocked",
  "version": "1.0.0",
  "description": "Browser extension that hides watched YouTube videos everywhere except History and Subscriptions.",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "icons": "node scripts/build-icons.mjs",
    "screenshots": "node scripts/screenshot-popup.mjs",
    "assets": "node scripts/render-assets.mjs",
    "package": "node scripts/package.mjs"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1"
  },
  "private": true
}
